        (size 2.54 2.54)
        (face "Monospace")
      )
      (justify left top)
    )
    (uuid "a7b8c9d0-e1f2-3456-abcd-789012345678")
  )

  (text "SERIAL OUTPUT TO RASPBERRY PI\n==============================\n\nFormat: BT:xxx.x,DT:xxx.x\\n\n\nBT = Bean Temperature (Celsius)\nDT = Drum/Exhaust Temperature (Celsius)\n\nBaud Rate: 115200\nUpdate Rate: 1 Hz (1000ms interval)"
    (exclude_from_sim no)
    (at 127 228.6 0)
